{
  "name": "@sol-hair/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "build:android": "expo export --platform android --output-dir dist/android --clear",
    "build:ios": "expo export --platform ios --output-dir dist/ios --clear",
    "build": "npm run build:android && npm run build:ios"
  },
  "private": true
}
