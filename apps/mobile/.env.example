# Leave empty in development to use the Expo/Metro host on port 4000.
# API and Expo must run on the same machine, reachable from the device.
EXPO_PUBLIC_API_BASE_URL=

# Set an explicit URL for a different API host/port, Expo tunnel, or release build.
# Android Emulator: http://10.0.2.2:4000
# iOS Simulator: http://localhost:4000
# Physical device: http://<current-LAN-IPv4>:4000
