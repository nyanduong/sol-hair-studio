<%
    const statuses = {
        confirmed: 'Đã xác nhận',
        in_progress: 'Đang phục vụ',
        completed: 'Đã hoàn tất',
        cancelled: 'Đã hủy',
        no_show: 'Không đến',
    }

    const date = new Intl.DateTimeFormat('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
    })

    const time = new Intl.DateTimeFormat('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
    })

    const money = new Intl.NumberFormat('vi-VN', {
        style: 'currency',
        currency: 'VND',
    })

%>
<!DOCTYPE html>
    <html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= title %> — Sol Hair Studio</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
        />
        <link rel="stylesheet" href="/owner-assets/css/owner.css" />
    </head>

    <body class="min-h-svh bg-canvas font-sans text-ink">
        <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
            <header>
                <p class="text-xs font-semibold uppercase tracking-widest text-terracotta">
                    Sol Hair Studio
                </p>
                <h1 class="mt-4 font-display text-4xl sm:text-5xl"><%= title %></h1>
                <p class="mt-3 text-sm leading-6 text-muted">
                    Theo dõi lịch hẹn trong ngày · Thời gian Việt Nam.
                </p>
            </header>

            <form
                method="get"
                action="/owner/appointments"
                class="mt-6 rounded-2xl border border-border bg-soft-surface p-4 sm:p-5"
            >
                <h2 class="text-xs font-semibold uppercase tracking-wider text-terracotta">
                    Bộ lọc lịch hẹn
                </h2>
                
                <div class="mt-4 grid gap-4 sm:grid-cols-3">
                    <label class="text-sm font-semibold">
                        Ngày hẹn
                        <input
                            type="date"
                            name="localDate"
                            value="<%= filters.localDate %>"
                            required
                            class="mt-2 min-h-11 w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
                        />
                    </label>

                    <label class="text-sm font-semibold">
                        Stylist
                        <select
                            name="staffId"
                            class="mt-2 min-h-11 w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
                        >
                        <option value="">Tất cả stylist</option>

                        <% if (filters.staffId && !staff.some(person => person.staffId === filters.staffId)) { %>
                            <option value="<%= filters.staffId %>" selected>Stylist đã chọn</option>
                        <% } %>

                        <% staff.forEach(person => { %>
                            <option
                                value="<%= person.staffId %>"
                                <%= filters.staffId === person.staffId ? 'selected' : '' %>
                            >
                                <%= person.displayName %><%= person.isActive ? '' : ' (ngừng hoạt động)' %>
                            </option>
                        <% }) %>
                        </select>
                    </label>

                    <label class="text-sm font-semibold">
                        Trạng thái
                        <select
                            name="status"
                            class="mt-2 min-h-11 w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
                        >
                        <option value="">Tất cả trạng thái</option>
                            <% Object.entries(statuses).forEach(([value, label]) => { %>
                                <option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>>
                                <%= label %>
                                </option>
                            <% }) %>
                        </select>
                    </label>
                </div>

                <button
                    type="submit"
                    class="mt-4 min-h-11 rounded-full bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-dark"
                >
                    Lọc lịch hẹn
                </button>
            </form>

                <% if (error) { %>
                    <section role="alert" class="mt-6 rounded-2xl border border-border bg-white p-6">
                        <h2 class="font-semibold text-terracotta">Chưa thể tải lịch hẹn</h2>
                        <p class="mt-2 text-sm text-muted"><%= error %></p>
                    </section>
                <% } else if (appointments.length === 0) { %>
                    <p role="status" class="mt-6 rounded-2xl border border-border bg-white p-6 text-sm text-muted">
                        Không có lịch hẹn phù hợp với ngày và bộ lọc đã chọn.
                    </p>
                <% } else { %>
                    <p class="mt-6 text-sm text-muted">
                        Đang hiển thị <%= appointments.length %> lịch hẹn trong trang này.
                    </p>
                    <section aria-label="Danh sách lịch hẹn" class="mt-4 grid gap-4 md:grid-cols-2">
                        <% appointments.forEach(appointment => { %>
                            <article class="rounded-2xl border border-border bg-white p-5 shadow-sm">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <h2 class="font-display text-2xl font-semibold">
                                        <%= time.format(new Date(appointment.startAt)) %>
                                        –
                                        <%= time.format(new Date(appointment.endAt)) %>
                                    </h2>

                                    <span class="rounded-full bg-soft-surface px-3 py-1 text-xs font-semibold text-terracotta">
                                        <%= statuses[appointment.status] ?? appointment.status %>
                                    </span>
                                </div>

                                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                                    <div class="rounded-xl bg-soft-surface p-3">
                                        <p class="text-xs text-muted">Khách hàng</p>
                                        <p class="mt-1 text-sm font-semibold">
                                            <%= appointment.customerSnapshot.displayName %>
                                        </p>
                                        <p class="mt-1 text-xs text-muted">
                                            <%= appointment.customerSnapshot.phone %>
                                        </p>
                                    </div>

                                    <div class="rounded-xl bg-soft-surface p-3">
                                        <p class="text-xs text-muted">Stylist</p>
                                        <p class="mt-1 text-sm font-semibold"><%= appointment.staffNameSnapshot %></p>
                                        <p class="mt-1 text-xs text-muted"><%= appointment.totalDurationMinutes %> phút</p>
                                    </div>
                                </div>
                                <p class="mt-4 text-sm">
                                    <%= appointment.items.map(item => item.name).join(' · ') %>
                                </p>

                                <div class="mt-4 flex flex-wrap justify-between gap-2 border-t border-border pt-3">
                                    <p class="text-xs text-muted"><%= date.format(new Date(appointment.startAt)) %></p>
                                    <p class="text-sm font-semibold text-terracotta">
                                        <%= money.format(appointment.totalPriceVnd) %>
                                    </p>
                                </div>

                                <p class="mt-3 break-all text-xs text-muted">Mã lịch: <%= appointment.id %></p>
                                <a
                                    href="/owner/appointments/<%= appointment.id %>"
                                    class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-terracotta hover:underline"
                                >
                                    Xem chi tiết →
                                </a>
                            </article>
                        <% }) %>
                    </section>
                    <% if (pagination.hasNextPage) {
                        const nextQuery = new URLSearchParams({
                            localDate: filters.localDate,
                            cursor: pagination.nextCursor,
                            limit: String(pagination.limit),
                        })
                        if (filters.staffId) nextQuery.set('staffId', filters.staffId)
                        if (filters.status) nextQuery.set('status', filters.status)
                    %>
                        <a
                            href="/owner/appointments?<%= nextQuery.toString() %>"
                            class="mt-6 inline-flex min-h-11 items-center rounded-full border border-terracotta px-6 py-2 text-sm font-semibold text-terracotta hover:bg-terracotta hover:text-white"
                        >
                            Trang tiếp →
                        </a>
                    <% } %>
                <% } %>
        </main>
    </body>
</html>