<%
    const dateTime = new Intl.DateTimeFormat('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
    })
%>

<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= title %> — Sol Hair Studio</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
        />
        <link rel="stylesheet" href="/owner-assets/css/owner.css" />
    </head>

    <body class="min-h-screen bg-canvas font-sans text-ink">
        <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
        <p class="text-sm font-semibold text-terracotta">Sol Hair Studio</p>
        <h1 class="mt-2 font-display text-4xl font-semibold">
            Kết quả cập nhật ETA
        </h1>

            <section class="mt-6 rounded-3xl border border-border bg-white p-6 sm:p-8">
                <% if (result) { %>
                <h2 class="text-lg font-semibold">Đã cập nhật ETA</h2>

                <p class="mt-4 text-sm text-muted">
                    Dự kiến kết thúc:
                    <%= dateTime.format(new Date(result.estimatedEndAt)) %>
                </p>
                <p class="mt-2 text-sm text-muted">
                    Giữ thời gian Stylist đến:
                    <%= dateTime.format(new Date(result.occupiedUntil)) %>
                    (gồm thời gian dọn).
                </p>

                <div class="mt-6 border-t border-border pt-6">
                    <h3 class="font-display text-2xl font-semibold">
                        Lịch bị ảnh hưởng
                    </h3>

                    <% if (result.ownerReviewRequired) { %>
                        <p role="alert" class="mt-2 text-sm font-semibold text-terracotta">
                            Có lịch bị ảnh hưởng, Owner cần xem xét xử lý.
                        </p>
                    <% } %>

                    <% if (!(result.affectedAppointments ?? []).length) { %>
                        <p class="mt-2 text-sm text-muted">
                            Chưa ghi nhận lịch bị ảnh hưởng tại thời điểm xử lý.
                        </p>
                    <% } else { %>
                    <ul class="mt-4 space-y-3">
                        <% for (const affected of result.affectedAppointments) { %>
                            <li class="rounded-xl border border-border p-4">
                                <a
                                href="/owner/appointments/<%= affected.id %>"
                                class="break-all text-sm font-semibold text-terracotta hover:underline"
                                >
                                Lịch <%= affected.id %>
                                </a>

                                <p class="mt-2 text-sm text-muted">
                                <%= dateTime.format(new Date(affected.startAt)) %>
                                – <%= dateTime.format(new Date(affected.endAt)) %>
                                </p>

                                <p class="mt-2 text-sm text-muted">
                                <%= affected.reasons.map(reason =>
                                    reason === 'staff_overlap'
                                    ? 'Trùng thời gian Stylist'
                                    : reason === 'customer_overlap'
                                        ? 'Trùng thời gian khách'
                                        : reason
                                ).join('; ') %>
                                </p>
                            </li>
                            <% } %>
                        </ul>
                    <% } %>
                </div>
                <% } else { %>
                <div role="alert">
                    <h2 class="text-lg font-semibold">
                        <%= pending
                            ? 'Chưa xác định được kết quả'
                            : 'Chưa thể cập nhật ETA' %>
                    </h2>
                    <p class="mt-2 text-sm text-muted"><%= error %></p>
                </div>

                <% if (pending) { %>
                        <p class="mt-4 text-sm text-muted">
                            Kiểm tra chi tiết lịch trước. Nếu cần gửi lại, dùng nút
                            bên dưới để giữ nguyên ETA và mã yêu cầu vừa gửi.
                        </p>

                        <form
                            method="post"
                            action="/owner/appointments/<%= appointmentId %>/eta"
                            class="mt-4"
                        >
                            <input
                                type="hidden"
                                name="expectedRevision"
                                value="<%= form.expectedRevision %>"
                            />
                            <input
                                type="hidden"
                                name="commandKey"
                                value="<%= form.commandKey %>"
                            />
                            <input
                                type="hidden"
                                name="estimatedEndLocal"
                                value="<%= form.estimatedEndLocal %>"
                            />

                            <button
                                type="submit"
                                class="min-h-11 rounded-full bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-dark"
                            >
                                Gửi lại cùng yêu cầu
                            </button>
                        </form>
                    <% } %>
                <% } %>

                <div class="mt-6 flex flex-wrap gap-4">
                    <a
                        href="/owner/appointments/<%= appointmentId %>"
                        class="text-sm font-semibold text-terracotta hover:underline"
                    >
                        Xem chi tiết lịch
                    </a>
                    <a
                        href="/owner/appointments"
                        class="text-sm font-semibold text-terracotta hover:underline"
                    >
                        Về danh sách lịch
                    </a>
                </div>
            </section>
        </main>
    </body>
</html>