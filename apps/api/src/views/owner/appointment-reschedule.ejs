<%
    const time = new Intl.DateTimeFormat('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
    })
%>

<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= title %> — Sol Hair Studio</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
        />
        <link rel="stylesheet" href="/owner-assets/css/owner.css" />
    </head>

    <body class="min-h-screen bg-canvas font-sans text-ink">
        <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
        <p class="text-sm font-semibold text-terracotta">Sol Hair Studio</p>

        <a
            href="/owner/appointments/<%= appointmentId %>"
            class="mt-4 inline-flex min-h-11 items-center text-sm text-terracotta hover:underline"
        >
            Về chi tiết lịch
        </a>

        <h1 class="mt-2 font-display text-4xl font-semibold">
            Đổi lịch hẹn
        </h1>

        <form
            method="get"
            action="/owner/appointments/<%= appointmentId %>/reschedule"
            class="mt-6 rounded-3xl border border-border bg-white p-6"
        >
            <label class="block text-sm font-semibold">
                Ngày muốn đổi
            <input
                type="date"
                name="localDate"
                value="<%= localDate %>"
                required
                class="mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
            />
            </label>

            <button
            type="submit"
            class="mt-4 min-h-11 rounded-full bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-dark"
            >
            Xem giờ trống
            </button>
        </form>

        <% if (error) { %>
            <section
                role="alert"
                class="mt-6 rounded-3xl border border-border bg-white p-6"
            >
                <p class="text-sm text-muted"><%= error %></p>
            </section>
        <% } else if (options) { %>
            <p class="mt-6 text-sm text-muted">
                Giờ hiển thị theo múi giờ Việt Nam. Dịch vụ, giá và thời lượng
                giữ theo lịch đã đặt. Đổi sát giờ cần nhập lý do.
            </p>

            <% if (!options.stylists.some(stylist => stylist.slots.length > 0)) { %>
                <section class="mt-4 rounded-3xl border border-border bg-white p-6">
                    <p class="text-sm text-muted">
                    Chưa có giờ trống phù hợp trong ngày này. Hãy chọn ngày khác.
                    </p>
                </section>
            <% } %>

            <% for (const stylist of options.stylists) {
                if (!stylist.slots.length) continue
            %>
                <section class="mt-4 rounded-3xl border border-border bg-white p-6">
                    <h2 class="text-lg font-semibold"><%= stylist.displayName %></h2>

                    <form
                    method="post"
                    action="/owner/appointments/<%= appointmentId %>/reschedule"
                    class="mt-4 space-y-4"
                    >
                    <input
                        type="hidden"
                        name="expectedRevision"
                        value="<%= options.revision %>"
                    />
                    <input
                        type="hidden"
                        name="commandKey"
                        value="<%= rescheduleKey %>"
                    />
                    <input
                        type="hidden"
                        name="staffId"
                        value="<%= stylist.staffId %>"
                    />

                    <label class="block text-sm font-semibold">
                        Giờ hẹn mới
                        <select
                        name="startAt"
                        required
                        class="mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
                        >
                        <option value="">Chọn giờ trống</option>
                        <% for (const slot of stylist.slots) { %>
                            <option value="<%= slot.startAt %>">
                            <%= time.format(new Date(slot.startAt)) %>
                            – <%= time.format(new Date(slot.endAt)) %>
                            </option>
                        <% } %>
                        </select>
                    </label>

                    <label class="block text-sm font-semibold">
                        Lý do đổi lịch
                        <textarea
                            name="reason"
                            rows="3"
                            maxlength="500"
                            class="mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
                        ></textarea>
                    </label>

                    <p class="text-sm text-muted">
                        Bắt buộc có lý do nếu giờ hẹn cũ còn dưới 2 giờ hoặc đã qua.
                        Backend sẽ kiểm tra lại giờ trống khi xác nhận.
                    </p>

                    <button
                        type="submit"
                        class="min-h-11 rounded-full bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-dark"
                    >
                        Xác nhận đổi sang Stylist này
                    </button>
                    </form>
                </section>
            <% } %>
        <% } %>
        </main>
    </body>
</html>