<%
    const time = new Intl.DateTimeFormat('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
    })
%>

<%- include('../layout-header', { title, identity: locals.identity, activeTab: 'appointments' }) %>
<script src="/admin-assets/js/admin-appointments.js" defer></script>

      <%- include('partials/page-header') %>
      <a href="<%= ownerUrl('/admin/appointments/' + appointmentId) %>" class="mt-4 inline-flex min-h-10 items-center rounded-xl border border-border bg-white px-4 py-2 text-xs font-semibold text-terracotta hover:bg-soft-surface">← Về chi tiết lịch</a>

        <form
            method="get"
            action="<%= ownerUrl('/admin/appointments/' + appointmentId + '/reschedule') %>"
            class="mt-6 rounded-2xl border border-[#e7e2da] bg-white p-6 shadow-sm"
        >
            <% if (ownerPersonal) { %><input type="hidden" name="view" value="mine" /><% } %>
            <% for (const key of ['staffId', 'status']) {
                if (ownerContext[key]) { %><input type="hidden" name="<%= key %>" value="<%= ownerContext[key] %>" /><% }
            } %>
            <label class="block text-sm font-semibold">
                Ngày muốn đổi
            <input
                type="date"
                name="localDate"
                value="<%= localDate %>"
                required
                class="mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
            />
            </label>

            <button
            type="submit"
            class="mt-4 min-h-11 rounded-xl bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-hover"
            >
            Xem giờ trống
            </button>
        </form>

        <% if (error) { %>
            <section
                role="alert"
                class="mt-6 rounded-2xl border border-[#e7e2da] bg-white p-6 shadow-sm"
            >
                <p class="text-sm text-muted"><%= error %></p>
            </section>
        <% } else if (options) { %>
            <p class="mt-6 text-sm text-muted">
                Giờ hiển thị theo múi giờ Việt Nam. Dịch vụ, giá và thời lượng
                giữ theo lịch đã đặt. Cần nhập lý do và xác nhận đã thống nhất lịch mới với khách.
            </p>

            <% if (!options.stylists.some(stylist => stylist.slots.length > 0)) { %>
                <section class="mt-4 rounded-2xl border border-[#e7e2da] bg-white p-6 shadow-sm">
                    <p class="text-sm text-muted">
                    Chưa có giờ trống phù hợp trong ngày này. Hãy chọn ngày khác.
                    </p>
                </section>
            <% } %>

            <% for (const stylist of options.stylists) {
                if (!stylist.slots.length) continue
            %>
                <section class="mt-4 rounded-2xl border border-[#e7e2da] bg-white p-6 shadow-sm">
                    <h2 class="text-lg font-semibold"><%= stylist.displayName %></h2>

                    <form
                    data-reschedule-form
                    method="post"
                    action="<%= ownerUrl('/admin/appointments/' + appointmentId + '/reschedule') %>"
                    class="mt-4 space-y-4"
                    >
                    <input
                        type="hidden"
                        name="expectedRevision"
                        value="<%= options.revision %>"
                    />
                    <input
                        type="hidden"
                        name="commandKey"
                        value="<%= rescheduleKey %>"
                    />
                    <input
                        type="hidden"
                        name="staffId"
                        value="<%= stylist.staffId %>"
                    />

                    <label class="block text-sm font-semibold">
                        Giờ hẹn mới
                        <select
                        name="startAt"
                        required
                        class="mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
                        >
                        <option value="">Chọn giờ trống</option>
                        <% for (const slot of stylist.slots) { %>
                            <option value="<%= slot.startAt %>">
                            <%= time.format(new Date(slot.startAt)) %>
                            – <%= time.format(new Date(slot.endAt)) %>
                            </option>
                        <% } %>
                        </select>
                    </label>

                    <label class="block text-sm font-semibold">
                        Lý do đổi lịch (bắt buộc)
                        <textarea
                            name="reason"
                            rows="3"
                            maxlength="500"
                            required
                            class="mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 font-normal"
                        ></textarea>
                    </label>

                    <p class="text-sm text-muted">
                        Bắt buộc có lý do nếu giờ hẹn cũ còn dưới 2 giờ hoặc đã qua.
                        Backend sẽ kiểm tra lại giờ trống khi xác nhận.
                    </p>

                    <label class="flex items-start gap-2 text-sm">
                        <input type="checkbox" name="customerAgreementConfirmed" value="true" required class="mt-1" />
                        Tôi đã trao đổi và thống nhất ngày, giờ, stylist mới với khách.
                    </label>

                    <button
                        type="submit"
                        class="min-h-11 rounded-xl bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-hover"
                    >
                        Xác nhận đổi sang Stylist này
                    </button>
                    </form>
                </section>
            <% } %>
        <% } %>
        
<%- include('../layout-footer') %>
