<%- include('partials/action-page-start') %>

        <section class="mt-6 rounded-2xl border border-[#e7e2da] bg-white p-6 shadow-sm sm:p-8">
            <% if (result) { %>
                <h2 class="text-lg font-semibold">Đã đổi lịch hẹn</h2>
                <p class="mt-2 text-sm text-muted">
                    Yêu cầu đổi lịch đã được xử lý thành công.
                    Mở chi tiết để xem thông tin mới.
                </p>
            <% } else { %>
                <div role="alert">
                    <h2 class="text-lg font-semibold">
                        <%= pending ? 'Chưa xác định được kết quả' : 'Chưa thể đổi lịch' %>
                    </h2>
                    <p class="mt-2 text-sm text-muted"><%= error %></p>
                </div>

                <% if (pending) { %>
                    <p class="mt-4 text-sm text-muted">
                        Kiểm tra chi tiết lịch trước. Nếu cần gửi lại, dùng nút bên dưới
                        để giữ nguyên giờ, Stylist, lý do và mã yêu cầu vừa gửi.
                    </p>

                    <form
                        method="post"
                        action="<%= ownerUrl('/admin/appointments/' + appointmentId + '/reschedule') %>"
                        class="mt-4"
                    >
                        <input
                            type="hidden"
                            name="expectedRevision"
                            value="<%= form.expectedRevision %>"
                        />
                        <input
                            type="hidden"
                            name="commandKey"
                            value="<%= form.commandKey %>"
                        />
                        <input
                            type="hidden"
                            name="startAt"
                            value="<%= form.startAt %>"
                        />
                        <input
                            type="hidden"
                            name="staffId"
                            value="<%= form.staffId %>"
                        />
                        <input
                            type="hidden"
                            name="reason"
                            value="<%= form.reason %>"
                        />
                        <input type="hidden" name="customerAgreementConfirmed" value="<%= form.customerAgreementConfirmed ? 'true' : 'false' %>" />

                        <button
                            type="submit"
                            class="min-h-11 rounded-xl bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-hover"
                        >
                            Gửi lại cùng yêu cầu
                        </button>
                    </form>
                <% } else { %>
                    <a
                        href="<%= ownerUrl('/admin/appointments/' + appointmentId + '/reschedule') %>"
                        class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-terracotta hover:underline"
                    >
                        Chọn lại lịch
                    </a>
                <% } %>
            <% } %>

            <div class="mt-6 flex flex-wrap gap-4">
            <a
                href="<%= ownerUrl('/admin/appointments/' + appointmentId + '') %>"
                class="text-sm font-semibold text-terracotta hover:underline"
            >
                Xem chi tiết lịch
            </a>
            <a
                href="<%= ownerUrl('/admin/appointments') %>"
                class="text-sm font-semibold text-terracotta hover:underline"
            >
                Về danh sách lịch
            </a>
            </div>
        </section>

<%- include('partials/action-page-end') %>
