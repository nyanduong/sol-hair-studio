<%
    const dateTime = new Intl.DateTimeFormat('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
    })
%>

<%- include('partials/action-page-start') %>

            <section class="mt-6 rounded-2xl border border-[#e7e2da] bg-white p-6 shadow-sm sm:p-8">
                <% if (result) { %>
                <h2 class="text-lg font-semibold">Đã cập nhật ETA</h2>

                <p class="mt-4 text-sm text-muted">
                    Dự kiến kết thúc:
                    <%= dateTime.format(new Date(result.estimatedEndAt)) %>
                </p>
                <p class="mt-2 text-sm text-muted">
                    Giữ thời gian Stylist đến:
                    <%= dateTime.format(new Date(result.occupiedUntil)) %>
                    (gồm thời gian dọn).
                </p>

                <div class="mt-6 border-t border-border pt-6">
                    <h3 class="font-sans text-2xl font-semibold">
                        Lịch bị ảnh hưởng
                    </h3>

                    <% if (result.ownerReviewRequired) { %>
                        <p role="alert" class="mt-2 text-sm font-semibold text-terracotta">
                            Có lịch bị ảnh hưởng, Owner cần xem xét xử lý.
                        </p>
                    <% } %>

                    <% if (!(result.affectedAppointments ?? []).length) { %>
                        <p class="mt-2 text-sm text-muted">
                            Chưa ghi nhận lịch bị ảnh hưởng tại thời điểm xử lý.
                        </p>
                    <% } else { %>
                    <ul class="mt-4 space-y-3">
                        <% for (const affected of result.affectedAppointments) { %>
                            <li class="rounded-xl border border-border p-4">
                                <a
                                href="<%= ownerUrl('/admin/appointments/' + affected.id, { view: '' }) %>"
                                class="break-all text-sm font-semibold text-terracotta hover:underline"
                                >
                                Lịch <%= affected.id %>
                                </a>

                                <p class="mt-2 text-sm text-muted">
                                <%= dateTime.format(new Date(affected.startAt)) %>
                                – <%= dateTime.format(new Date(affected.endAt)) %>
                                </p>

                                <p class="mt-2 text-sm text-muted">
                                <%= affected.reasons.map(reason =>
                                    reason === 'staff_overlap'
                                    ? 'Trùng thời gian Stylist'
                                    : reason === 'customer_overlap'
                                        ? 'Trùng thời gian khách'
                                        : reason
                                ).join('; ') %>
                                </p>
                            </li>
                            <% } %>
                        </ul>
                    <% } %>
                </div>
                <% } else { %>
                <div role="alert">
                    <h2 class="text-lg font-semibold">
                        <%= pending
                            ? 'Chưa xác định được kết quả'
                            : 'Chưa thể cập nhật ETA' %>
                    </h2>
                    <p class="mt-2 text-sm text-muted"><%= error %></p>
                </div>

                <% if (pending) { %>
                        <p class="mt-4 text-sm text-muted">
                            Kiểm tra chi tiết lịch trước. Nếu cần gửi lại, dùng nút
                            bên dưới để giữ nguyên ETA và mã yêu cầu vừa gửi.
                        </p>

                        <form
                            method="post"
                            action="<%= ownerUrl('/admin/appointments/' + appointmentId + '/eta') %>"
                            class="mt-4"
                        >
                            <input
                                type="hidden"
                                name="expectedRevision"
                                value="<%= form.expectedRevision %>"
                            />
                            <input
                                type="hidden"
                                name="commandKey"
                                value="<%= form.commandKey %>"
                            />
                            <input
                                type="hidden"
                                name="estimatedEndLocal"
                                value="<%= form.estimatedEndLocal %>"
                            />

                            <button
                                type="submit"
                                class="min-h-11 rounded-xl bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-hover"
                            >
                                Gửi lại cùng yêu cầu
                            </button>
                        </form>
                    <% } %>
                <% } %>

                <div class="mt-6 flex flex-wrap gap-4">
                    <a
                        href="<%= ownerUrl('/admin/appointments/' + appointmentId + '') %>"
                        class="text-sm font-semibold text-terracotta hover:underline"
                    >
                        Xem chi tiết lịch
                    </a>
                    <a
                        href="<%= ownerUrl('/admin/appointments') %>"
                        class="text-sm font-semibold text-terracotta hover:underline"
                    >
                        Về danh sách lịch
                    </a>
                </div>
            </section>

<%- include('partials/action-page-end') %>
