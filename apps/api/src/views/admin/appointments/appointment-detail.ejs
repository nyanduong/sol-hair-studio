<%
  const dateTime = new Intl.DateTimeFormat('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
  const date = new Intl.DateTimeFormat('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', day: '2-digit', month: '2-digit', year: 'numeric' })
  const time = new Intl.DateTimeFormat('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
  const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' })
%>
<%- include('../layout-header', { title, identity: locals.identity, activeTab: 'appointments' }) %>
<script src="/admin-assets/js/admin-appointments.js" defer></script>

      <% if (!locals.embeddedAppointment) { %>
      <%- include('partials/page-header') %>
      <a href="<%= ownerUrl('/admin/appointments') %>" class="mt-4 inline-flex min-h-10 items-center rounded-xl border border-[#e7e2da] bg-white px-4 py-1.5 text-xs font-semibold text-terracotta shadow-sm hover:bg-soft-surface">← Về lịch hẹn trong ngày</a>
      <% } %>
      <% if (error) { %>
        <section role="alert" class="mt-6 rounded-2xl border border-terracotta/20 bg-terracotta/5 p-6">
          <h2 class="font-semibold text-terracotta">Chưa thể xem lịch hẹn</h2>
          <p class="mt-2 text-sm text-muted"><%= error %></p>
        </section>
      <% } else if (appointment) { %>
        <article data-appointment-detail="<%= appointment.id %>" data-appointment-reference="<%= appointment.referenceCode || '' %>" data-personal-staff-id="<%= personalStaff?.staffId ?? '' %>" class="<%= locals.embeddedAppointment ? '' : 'mt-6 rounded-2xl border border-border' %> overflow-hidden bg-white">
          <header data-appointment-heading <%= locals.embeddedAppointment ? 'hidden' : '' %> class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4 sm:px-6">
            <div><p class="text-xs tracking-wider text-muted">LỊCH SALON / CHI TIẾT</p><h2 class="mt-2 text-xl font-bold">Lịch hẹn <%= appointment.referenceCode || 'Chưa cấp mã' %></h2></div>
            <%- include('partials/status', { status: appointment.status }) %>
          </header>
          <% if (appointment.note) { %><p class="border-b border-border bg-canvas px-6 py-4 text-sm"><strong>Ghi chú từ khách:</strong> <%= appointment.note %></p><% } %>
          <div class="grid <%= locals.embeddedAppointment ? '' : 'md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]' %>">
            <div class="min-w-0">
              <%- include('partials/detail-summary', { dateTime, date, time, money }) %>
              <%- include('partials/detail-progress', { dateTime }) %>
              <%- include('partials/detail-actions', { dateTime }) %>
            </div>
            <% if (locals.paymentToken) { %><%- include('../payment', { appointmentId: appointment.id, token: paymentToken }) %><% } %>
          </div>
        </article>
      <% } %>
    
<%- include('../layout-footer') %>
