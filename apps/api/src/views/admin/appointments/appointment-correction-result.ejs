<%- include('partials/action-page-start') %>

            <section class="mt-6 rounded-2xl border border-[#e7e2da] bg-white p-6 shadow-sm sm:p-8">
                <% if (result) { %>
                <h2 class="text-lg font-semibold">Đã sửa thao tác nhầm</h2>
                <p class="mt-2 text-sm text-muted">
                    <%= operation === 'correct-start'
                    ? 'Lịch đã trở về trạng thái đã xác nhận.'
                    : 'Lịch đã trở về trạng thái đang phục vụ.' %>
                </p>
                <p class="mt-2 text-sm text-muted">
                    Mở chi tiết để xem dữ liệu mới hoặc xem lịch sử thao tác.
                </p>
                <% } else { %>
                    <div role="alert">
                        <h2 class="text-lg font-semibold">
                            <%= pending
                                ? 'Chưa xác định được kết quả'
                                : 'Chưa thể sửa thao tác nhầm' %>
                        </h2>
                        <p class="mt-2 text-sm text-muted"><%= error %></p>
                    </div>
                    <% if (locals.conflicts) {
                        const conflictTime = new Intl.DateTimeFormat('vi-VN', {
                            timeZone: 'Asia/Ho_Chi_Minh', dateStyle: 'short', timeStyle: 'short',
                        })
                    %>
                        <section class="mt-4 rounded-xl border border-terracotta/20 bg-terracotta/5 p-4">
                            <h3 class="text-sm font-semibold text-terracotta">Cần xử lý xung đột trước khi khôi phục</h3>
                            <% if (conflicts.shiftConflict) { %><p class="mt-2 text-sm">Khoảng phục vụ không nằm trong một ca làm hợp lệ.</p><% } %>
                            <% for (const item of conflicts.timeOffConflicts ?? []) { %>
                                <p class="mt-2 text-sm">Trùng thời gian nghỉ: <%= conflictTime.format(new Date(item.startAt)) %> – <%= conflictTime.format(new Date(item.endAt)) %>.</p>
                            <% } %>
                            <ul class="mt-3 space-y-2">
                                <% for (const item of conflicts.conflictingAppointments ?? []) { %>
                                    <li class="rounded-lg border border-border bg-white p-3">
                                        <a class="break-all text-sm font-semibold text-terracotta hover:underline" href="<%= ownerUrl('/admin/appointments/' + item.id, { view: '' }) %>">Lịch <%= item.id %></a>
                                        <p class="mt-1 text-xs text-muted"><%= conflictTime.format(new Date(item.startAt)) %> – <%= conflictTime.format(new Date(item.endAt)) %></p>
                                        <p class="mt-1 text-xs text-muted"><%= item.reasons.map(reason => reason === 'staff_overlap' ? 'Trùng thời gian Stylist' : reason === 'customer_overlap' ? 'Trùng thời gian khách' : reason).join('; ') %></p>
                                    </li>
                                <% } %>
                            </ul>
                        </section>
                    <% } %>

                    <% if (pending) { %>
                        <p class="mt-4 text-sm text-muted">
                            Kiểm tra chi tiết lịch trước. Nếu cần gửi lại, dùng nút
                            bên dưới để giữ nguyên dữ liệu và mã yêu cầu vừa gửi.
                        </p>

                        <form
                            method="post"
                            action="<%= ownerUrl('/admin/appointments/' + appointmentId + '/' + operation) %>"
                            class="mt-4"
                        >
                            <input
                                type="hidden"
                                name="expectedRevision"
                                value="<%= form.expectedRevision %>"
                            />
                            <input
                                type="hidden"
                                name="commandKey"
                                value="<%= form.commandKey %>"
                            />
                            <input
                                type="hidden"
                                name="reason"
                                value="<%= form.reason %>"
                            />
                            <input
                                type="hidden"
                                name="<%= confirmationField %>"
                                value="<%= form.confirmed ? 'true' : 'false' %>"
                            />

                            <% if (operation === 'correct-complete') { %>
                                <input
                                type="hidden"
                                name="estimatedEndLocal"
                                value="<%= form.estimatedEndLocal %>"
                                />
                            <% } %>

                            <button
                                type="submit"
                                class="min-h-11 rounded-xl bg-terracotta px-6 py-2 text-sm font-semibold text-white hover:bg-terracotta-hover"
                            >
                                Gửi lại cùng yêu cầu
                            </button>
                        </form>
                    <% } %>
                <% } %>

                <div class="mt-6 flex flex-wrap gap-4">
                    <a
                        href="<%= ownerUrl('/admin/appointments/' + appointmentId + '') %>"
                        class="text-sm font-semibold text-terracotta hover:underline"
                    >
                        Xem chi tiết lịch
                    </a>
                    <a
                        href="<%= ownerUrl('/admin/appointments/' + appointmentId + '/audit') %>"
                        class="text-sm font-semibold text-terracotta hover:underline"
                    >
                        Xem lịch sử thao tác
                    </a>
                </div>
            </section>

<%- include('partials/action-page-end') %>
