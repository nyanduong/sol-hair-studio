<%
  const state = locals.pending ? 'pending' : locals.error ? 'error' : locals.result ? 'success' : 'form'
%>
<% if (!appointmentDialog) { %>
  <%- include('../../layout-header', { title, identity: locals.identity, activeTab: 'appointments' }) %>
  <script src="/admin-assets/js/admin-appointments.js" defer></script>
  <a href="<%= ownerUrl('/admin/appointments/' + appointmentId) %>" class="mb-6 inline-flex min-h-10 items-center rounded-xl border border-border bg-white px-4 py-2 text-xs font-semibold text-terracotta hover:bg-soft-surface">← Về chi tiết lịch này</a>
<% } %>
<section data-appointment-response="<%= appointmentId %>" data-command-state="<%= state %>" data-result-staff-id="<%= locals.result?.staffId ?? '' %>" class="lg:flex lg:min-h-0 lg:flex-1 lg:flex-col">
  <h2 class="text-2xl font-bold tracking-tight text-ink"><%= title %></h2>
  <p class="mt-1 break-all text-xs text-muted">Mã lịch đang thao tác: <%= appointmentId %></p>
