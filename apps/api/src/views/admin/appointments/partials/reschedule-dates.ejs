      <section aria-labelledby="reschedule-date-title" class="shrink-0">
        <h3 id="reschedule-date-title" class="text-sm font-bold uppercase tracking-wider">1. Chọn ngày mới</h3>
        <div class="mt-2 grid grid-cols-4 gap-2 sm:grid-cols-8">
          <% for (let day = 0; day < 8; day++) {
            const date = new Date(today + 'T12:00:00.000Z')
            date.setUTCDate(date.getUTCDate() + day)
            const value = date.toISOString().slice(0, 10)
          %>
            <a data-reschedule-date href="<%= ownerUrl('/admin/appointments/' + appointmentId + '/reschedule', { localDate: value }) %>" <%- pickerDate === value ? 'aria-current="date"' : '' %> class="rounded-xl border px-2 py-1.5 text-center text-xs <%= pickerDate === value ? 'border-terracotta bg-terracotta text-white' : 'border-border bg-white hover:bg-soft-surface' %>">
              <span class="block"><%= new Intl.DateTimeFormat('vi-VN', { weekday: 'short', timeZone: 'UTC' }).format(date) %></span>
              <span class="block text-sm font-bold"><%= date.getUTCDate() %>/<%= date.getUTCMonth() + 1 %></span>
            </a>
          <% } %>
        </div>
        <p class="mt-2 text-xs text-muted">Đổi lịch từ hôm nay đến tối đa 7 ngày tới (168 giờ tính từ hiện tại).</p>
        <form method="get" data-reschedule-date-form action="/admin/appointments/<%= appointmentId %>/reschedule" class="mt-2 flex flex-wrap items-center gap-3">
          <% for (const key of ['view', 'staffId', 'status', 'q']) {
            if (ownerContext[key]) { %><input type="hidden" name="<%= key %>" value="<%= ownerContext[key] %>" /><% }
          } %>
          <label class="flex items-center gap-2 text-sm font-medium">Ngày muốn đổi<input type="date" name="localDate" value="<%= pickerDate %>" min="<%= today %>" max="<%= lastDate %>" required class="min-h-10 rounded-xl border border-border bg-white px-3 py-2 text-sm focus:border-terracotta focus:outline-none" /></label>
          <button type="submit" class="min-h-11 rounded-xl border border-border bg-white px-4 text-sm font-semibold hover:bg-soft-surface">Xem giờ trống</button>
        </form>
      </section>
