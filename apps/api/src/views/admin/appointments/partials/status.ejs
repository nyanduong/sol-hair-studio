<%
  const configs = {
    confirmed: ['Đã xác nhận', 'bg-emerald-50 text-emerald-800 border-emerald-200/60', 'bg-emerald-500'],
    in_progress: ['Đang phục vụ', 'bg-blue-50 text-blue-800 border-blue-200/60', 'bg-blue-500'],
    completed: ['Đã hoàn tất', 'bg-stone-100 text-stone-700 border-stone-200/80', 'bg-stone-500'],
    cancelled: ['Đã hủy', 'bg-rose-50 text-rose-700 border-rose-200/60', 'bg-rose-500'],
    no_show: ['Không đến', 'bg-amber-50 text-amber-800 border-amber-200/60', 'bg-amber-500'],
  }
  const config = configs[status] ?? [status, 'bg-stone-50 text-stone-600 border-stone-200', 'bg-stone-400']
%>
<span class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border px-2.5 py-0.5 text-xs font-semibold <%= config[1] %>">
  <span aria-hidden="true" class="size-1.5 rounded-xl <%= config[2] %>"></span><%= config[0] %>
</span>
