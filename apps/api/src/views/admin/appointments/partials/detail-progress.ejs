<details class="border-t border-border px-5 py-4 sm:px-6">
  <summary class="cursor-pointer text-xs font-semibold text-muted">Tiến độ và lịch sử thao tác</summary>
  <% if (appointment.startedAt || appointment.estimatedEndAt) { %>
    <section aria-label="Thời gian phục vụ thực tế" class="mt-5 border-t border-border pt-4">
      <h3 class="text-xs font-semibold text-muted">Tiến độ phục vụ</h3>
      <dl class="mt-3 grid gap-3 text-xs sm:grid-cols-2">
        <% if (appointment.startedAt) { %><div><dt class="text-muted">Bắt đầu thực tế</dt><dd class="mt-1 font-semibold"><%= dateTime.format(new Date(appointment.startedAt)) %></dd></div><% } %>
        <% if (appointment.completedAt) { %><div><dt class="text-muted">Hoàn tất thực tế</dt><dd class="mt-1 font-semibold"><%= dateTime.format(new Date(appointment.completedAt)) %></dd></div><% } %>
        <% if (appointment.estimatedEndAt) { %><div><dt class="text-terracotta">Giờ dự kiến xong</dt><dd class="mt-1 font-semibold"><%= dateTime.format(new Date(appointment.estimatedEndAt)) %></dd></div><% } %>
      </dl>
      <% if (appointment.completedAt) { %><p class="mt-3 text-xs text-muted">Thời gian dọn kết thúc: <%= dateTime.format(new Date(Date.parse(appointment.completedAt) + 600_000)) %></p><% } %>
    </section>
  <% } %>
  <a href="<%= ownerUrl('/admin/appointments/' + appointment.id + '/audit') %>" class="mt-3 inline-flex min-h-10 items-center text-xs font-semibold text-muted underline underline-offset-4 hover:text-terracotta">Xem lịch sử thao tác →</a>
</details>
