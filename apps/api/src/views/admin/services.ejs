<%- include('layout-header', { title, identity }) %>

<div class="space-y-6">
  <!-- Notifications -->
  <% if (success === 'created') { %>
    <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span class="text-sm font-semibold text-emerald-900">Thêm dịch vụ mới thành công!</span>
      </div>
      <a href="/admin/services" class="text-xs font-semibold text-emerald-700 hover:underline">Đóng</a>
    </div>
  <% } else if (success === 'updated') { %>
    <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span class="text-sm font-semibold text-emerald-900">Cập nhật dịch vụ thành công!</span>
      </div>
      <a href="/admin/services" class="text-xs font-semibold text-emerald-700 hover:underline">Đóng</a>
    </div>
  <% } else if (success === 'toggled') { %>
    <div class="rounded-xl bg-blue-50 border border-blue-200 p-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span class="text-sm font-semibold text-blue-900">Đã cập nhật trạng thái hiển thị của dịch vụ!</span>
      </div>
      <a href="/admin/services" class="text-xs font-semibold text-blue-700 hover:underline">Đóng</a>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="rounded-xl bg-red-50 border border-red-200 p-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
        <span class="text-sm font-semibold text-red-900"><%= error %></span>
      </div>
      <a href="/admin/services" class="text-xs font-semibold text-red-700 hover:underline">Đóng</a>
    </div>
  <% } %>

  <!-- Page Header & Action -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-[#e7e2da] pb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-ink">Quản lý Dịch vụ Salon</h1>
      <p class="mt-1 text-sm text-[#7a7269]">
        Cấu hình danh mục dịch vụ, thời lượng làm đẹp, giá niêm yết và trạng thái nhận đặt lịch của khách hàng.
      </p>
    </div>
    <div>
      <button
        type="button"
        onclick="openAddModal()"
        class="inline-flex items-center px-4 py-2.5 rounded-xl bg-[#b55338] text-white text-sm font-semibold shadow-sm hover:bg-[#96422b] transition active:scale-[0.98] space-x-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Thêm dịch vụ mới</span>
      </button>
    </div>
  </div>

  <!-- KPI Stats -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white rounded-2xl p-5 border border-[#e7e2da] shadow-sm">
      <div class="text-xs font-semibold text-[#7a7269] uppercase tracking-wider">Tổng dịch vụ</div>
      <div class="mt-2 text-3xl font-bold text-ink"><%= stats.total %></div>
      <div class="mt-1 text-xs text-[#7a7269]">Dịch vụ được đăng ký trong hệ thống</div>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-[#e7e2da] shadow-sm">
      <div class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Đang hiển thị (Nhận khách)</div>
      <div class="mt-2 text-3xl font-bold text-emerald-700"><%= stats.activeCount %></div>
      <div class="mt-1 text-xs text-[#7a7269]">Khách có thể xem và đặt lịch trên Web / App</div>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-[#e7e2da] shadow-sm">
      <div class="text-xs font-semibold text-amber-700 uppercase tracking-wider">Đang ẩn (Tạm ngưng)</div>
      <div class="mt-2 text-3xl font-bold text-amber-700"><%= stats.inactiveCount %></div>
      <div class="mt-1 text-xs text-[#7a7269]">Không nhận đặt mới, bảo lưu lịch sử cũ</div>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="bg-white rounded-2xl p-4 border border-[#e7e2da] shadow-sm">
    <form action="/admin/services" method="GET" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
      <div class="md:col-span-5">
        <label for="search" class="block text-xs font-semibold text-[#7a7269] mb-1">Tìm kiếm dịch vụ</label>
        <div class="relative">
          <input
            id="search"
            name="search"
            type="text"
            value="<%= currentSearch %>"
            placeholder="Tìm theo tên hoặc mã dịch vụ..."
            class="w-full rounded-xl border border-[#e7e2da] pl-9 pr-3 py-2 text-sm text-ink placeholder-[#7a7269]/60 focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
          />
          <svg class="w-4 h-4 text-[#7a7269] absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
      </div>

      <div class="md:col-span-3">
        <label for="category" class="block text-xs font-semibold text-[#7a7269] mb-1">Danh mục</label>
        <select
          id="category"
          name="category"
          class="w-full rounded-xl border border-[#e7e2da] px-3 py-2 text-sm text-ink bg-white focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
        >
          <option value="all" <%= currentCategory === 'all' ? 'selected' : '' %>>Tất cả danh mục</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= currentCategory === cat ? 'selected' : '' %>><%= cat %></option>
          <% }); %>
        </select>
      </div>

      <div class="md:col-span-2">
        <label for="status" class="block text-xs font-semibold text-[#7a7269] mb-1">Trạng thái</label>
        <select
          id="status"
          name="status"
          class="w-full rounded-xl border border-[#e7e2da] px-3 py-2 text-sm text-ink bg-white focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
        >
          <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>Tất cả</option>
          <option value="active" <%= currentStatus === 'active' ? 'selected' : '' %>>Đang hiện</option>
          <option value="inactive" <%= currentStatus === 'inactive' ? 'selected' : '' %>>Đang ẩn</option>
        </select>
      </div>

      <div class="md:col-span-2 flex items-center space-x-2">
        <button
          type="submit"
          class="flex-1 rounded-xl bg-ink text-white py-2 px-3 text-sm font-semibold hover:bg-black transition text-center"
        >
          Lọc
        </button>
        <% if (currentSearch || currentCategory !== 'all' || currentStatus !== 'all') { %>
          <a
            href="/admin/services"
            class="min-h-11 rounded-xl border border-[#e7e2da] py-2 px-3 text-xs font-semibold text-[#7a7269] hover:text-ink hover:bg-[#f4f0ea] transition text-center"
          >
            Đặt lại
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Services Table -->
  <div class="bg-white rounded-2xl border border-[#e7e2da] shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-[#e7e2da] text-left text-sm text-ink">
        <thead class="bg-[#fcfbf9] text-xs font-semibold uppercase tracking-wider text-[#7a7269]">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 sm:pl-6">Ảnh</th>
            <th scope="col" class="px-3 py-3.5">Dịch vụ</th>
            <th scope="col" class="px-3 py-3.5">Danh mục</th>
            <th scope="col" class="px-3 py-3.5">Giá niêm yết</th>
            <th scope="col" class="px-3 py-3.5">Thời lượng</th>
            <th scope="col" class="px-3 py-3.5">Giữ chỗ</th>
            <th scope="col" class="px-3 py-3.5">Trạng thái</th>
            <th scope="col" class="py-3.5 pl-3 pr-4 sm:pr-6 text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#e7e2da] bg-white">
          <% if (services.length === 0) { %>
            <tr>
              <td colspan="8" class="py-12 text-center text-[#7a7269]">
                <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <p class="mt-2 text-sm font-medium">Không tìm thấy dịch vụ nào phù hợp.</p>
                <p class="mt-1 text-xs text-gray-500">Hãy thử đổi từ khóa tìm kiếm hoặc bấm nút Thêm dịch vụ mới.</p>
              </td>
            </tr>
          <% } %>

          <% services.forEach(function(service) { %>
            <tr class="hover:bg-[#fcfbf9]/70 transition">
              <td class="whitespace-nowrap py-4 pl-4 pr-3 sm:pl-6">
                <% if (service.imageUrl) { %>
                  <img
                    src="<%= service.imageUrl %>"
                    alt="<%= service.name %>"
                    class="h-14 w-14 rounded-xl object-cover border border-[#e7e2da] shadow-xs"
                    loading="lazy"
                  />
                <% } else { %>
                  <div class="h-14 w-14 rounded-xl bg-[#f4f0ea] border border-[#e7e2da] flex items-center justify-center text-[#7a7269]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                <% } %>
              </td>
              <td class="px-3 py-4">
                <div class="font-semibold text-ink text-sm"><%= service.name %></div>
                <div class="mt-0.5 flex items-center space-x-2 text-xs text-[#7a7269]">
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-mono bg-[#f4f0ea] text-[#2c2825]">
                    Mã: <%= service.id %>
                  </span>
                </div>
                <% if (service.description) { %>
                  <p class="mt-1 text-xs text-[#7a7269] line-clamp-1 max-w-xs"><%= service.description %></p>
                <% } %>
              </td>
              <td class="whitespace-nowrap px-3 py-4">
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-[#b55338]/10 text-[#b55338]">
                  <%= service.category %>
                </span>
              </td>
              <td class="whitespace-nowrap px-3 py-4 font-semibold text-ink">
                <%= (service.priceVnd || 0).toLocaleString('vi-VN') %> đ
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-xs text-[#7a7269]">
                <% if (service.durationMinutes) { %>
                  <%= service.durationMinutes.min === service.durationMinutes.max ? service.durationMinutes.min : (service.durationMinutes.min + '–' + service.durationMinutes.max) %> phút
                <% } else { %>
                  —
                <% } %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-xs text-[#7a7269]">
                <%= service.bookingDurationMinutes ? service.bookingDurationMinutes + ' phút' : 'Chưa cấu hình' %>
              </td>
              <td class="whitespace-nowrap px-3 py-4">
                <div class="flex items-center space-x-2">
                  <% if (service.isActive) { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                      Đang hiện
                    </span>
                    <form action="/admin/services/<%= encodeURIComponent(service.id) %>/toggle" method="POST" class="inline">
                      <input type="hidden" name="isActive" value="false" />
                      <button
                        type="submit"
                        title="Tạm ẩn dịch vụ này (khách không đặt mới)"
                        class="text-[11px] font-medium text-amber-700 hover:text-amber-900 border border-amber-200 hover:bg-amber-50 px-2 py-0.5 rounded transition"
                      >
                        Ẩn
                      </button>
                    </form>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
                      Đang ẩn
                    </span>
                    <form action="/admin/services/<%= encodeURIComponent(service.id) %>/toggle" method="POST" class="inline">
                      <input type="hidden" name="isActive" value="true" />
                      <button
                        type="submit"
                        title="Mở lại nhận khách cho dịch vụ này"
                        class="text-[11px] font-medium text-emerald-700 hover:text-emerald-900 border border-emerald-200 hover:bg-emerald-50 px-2 py-0.5 rounded transition"
                      >
                        Hiện
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
              <td class="whitespace-nowrap py-4 pl-3 pr-4 sm:pr-6 text-right">
                <button
                  type="button"
                  data-service='<%= JSON.stringify(service) %>'
                  onclick="openEditModal(this)"
                  class="inline-flex items-center space-x-1 text-xs font-semibold text-[#b55338] hover:text-[#96422b] bg-[#b55338]/10 hover:bg-[#b55338]/20 px-3 py-1.5 rounded-lg transition"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                  <span>Chỉnh sửa</span>
                </button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ==================== MODAL: THÊM DỊCH VỤ ==================== -->
<dialog id="addModal" aria-label="Thêm dịch vụ" class="fixed inset-0 m-auto w-[min(920px,calc(100%_-_2rem))] max-h-[calc(100vh_-_0.5rem)] overflow-y-auto rounded-2xl bg-white p-0 backdrop:bg-black/40">
  <div class="relative w-full max-w-none bg-white rounded-2xl shadow-2xl border border-[#e7e2da]">
    <div class="sticky top-0 z-10 px-5 py-3 border-b border-[#e7e2da] flex items-center justify-between bg-[#fcfbf9]">
      <h3 class="text-lg font-bold text-ink">Thêm dịch vụ mới</h3>
      <button type="button" onclick="closeAddModal()" aria-label="Đóng form dịch vụ" class="text-[#7a7269] hover:text-ink text-lg font-bold min-h-11 min-w-11">&times;</button>
    </div>

    <%- include('service-form', { prefix: 'add' }) %>
  </div>
</dialog>

<!-- ==================== MODAL: CHỈNH SỬA DỊCH VỤ ==================== -->
<dialog id="editModal" aria-label="Chỉnh sửa dịch vụ" class="fixed inset-0 m-auto w-[min(920px,calc(100%_-_2rem))] max-h-[calc(100vh_-_0.5rem)] overflow-y-auto rounded-2xl bg-white p-0 backdrop:bg-black/40">
  <div class="relative w-full max-w-none bg-white rounded-2xl shadow-2xl border border-[#e7e2da]">
    <div class="sticky top-0 z-10 px-5 py-3 border-b border-[#e7e2da] flex items-center justify-between bg-[#fcfbf9]">
      <div>
        <h3 class="text-lg font-bold text-ink">Chỉnh sửa dịch vụ</h3>
        <span id="edit_id_badge" class="text-xs font-mono text-[#7a7269]"></span>
      </div>
      <button type="button" onclick="closeEditModal()" aria-label="Đóng form dịch vụ" class="text-[#7a7269] hover:text-ink text-lg font-bold min-h-11 min-w-11">&times;</button>
    </div>

    <%- include('service-form', { prefix: 'edit' }) %>
  </div>
</dialog>

<script>
  function validateServiceForm(form) {
    const duration = form.elements.bookingDurationMinutes;
    duration.setCustomValidity('');
    return form.reportValidity();
  }
  document.addEventListener('input', function(event) {
    const form = event.target.closest('#editForm, #addModal form');
    if (form) form.elements.bookingDurationMinutes.setCustomValidity('');
  });
  function openAddModal() {
    document.getElementById('addForm').reset();
    document.getElementById('add_bookingDurationMinutes').setCustomValidity('');
    document.getElementById('add_imageUrl').value = '';
    document.getElementById('add_draftNotice').querySelector('p').textContent = 'Mã dịch vụ và thứ tự hiển thị sẽ được tạo tự động.';
    const fileInput = document.getElementById('add_imageFileInput');
    if (fileInput) fileInput.value = '';
    const dataUrlInput = document.getElementById('add_imageDataUrl');
    if (dataUrlInput) dataUrlInput.value = '';
    const label = document.getElementById('add_fileLabel');
    if (label) label.textContent = 'Chưa chọn ảnh';
    const preview = document.getElementById('add_previewImg');
    if (preview) {
      preview.src = '';
      preview.classList.add('hidden');
    }
    document.getElementById('addModal').showModal();
  }


  async function refreshCategories(prefix) {
    const notice = document.getElementById(prefix + '_categoryNotice'); notice.textContent = 'Đang cập nhật…';
    try {
      const response = await fetch('/admin/service-categories/options', { cache: 'no-store', headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('Không tải được danh mục');
      const body = await response.json();
      const select = document.getElementById(prefix + '_category'); const value = select.value;
      const existing = select.querySelector('[data-existing-category]');
      select.replaceChildren(); const placeholder = document.createElement('option'); placeholder.value = ''; placeholder.textContent = 'Chọn danh mục'; select.append(placeholder);
      for (const item of body.data.filter(item => item.isActive)) { const option = document.createElement('option'); option.value = item.id; option.textContent = item.name; select.append(option); }
      if (prefix === 'edit' && existing && ![...select.options].some(option => option.value === existing.value)) select.append(existing);
      select.value = value;
      notice.textContent = 'Đã cập nhật danh mục. Dữ liệu đang nhập được giữ nguyên.';
    } catch { notice.textContent = 'Chưa tải được danh mục. Kiểm tra đăng nhập/kết nối và thử lại.'; }
  }
  function chooseCategory(prefix, data) {
    const select = document.getElementById(prefix + '_category');
    select.querySelectorAll('[data-existing-category]').forEach(option => option.remove());
    const option = [...select.options].find(item => (data.categoryId && item.value === String(data.categoryId)) || item.textContent === data.category);
    if (option) select.value = option.value;
    else if (prefix === 'edit' && data.categoryId) {
      const existing = document.createElement('option'); existing.value = String(data.categoryId); existing.textContent = data.category + ' (ngừng dùng)'; existing.dataset.existingCategory = 'true'; select.append(existing); select.value = existing.value;
    } else select.value = '';
  }

  function closeAddModal() {
    document.getElementById('addModal').close();
  }

  function openEditModal(button) {
    try {
      const data = JSON.parse(button.getAttribute('data-service'));
      const form = document.getElementById('editForm');
      form.elements.bookingDurationMinutes.setCustomValidity('');
      form.action = '/admin/services/' + encodeURIComponent(data.id) + '/update';

      document.getElementById('edit_id_badge').textContent = 'Mã ID: ' + data.id;
      document.getElementById('edit_name').value = data.name || '';
      chooseCategory('edit', data);
      document.getElementById('edit_priceVnd').value = data.priceVnd !== undefined ? data.priceVnd : '';
      document.getElementById('edit_bookingDurationMinutes').value = data.bookingDurationMinutes || data.durationMinutes?.max || '';
      document.getElementById('edit_imageUrl').value = data.imageUrl || '';
      const editFileInput = document.getElementById('edit_imageFileInput');
      if (editFileInput) editFileInput.value = '';
      const editDataUrlInput = document.getElementById('edit_imageDataUrl');
      if (editDataUrlInput) editDataUrlInput.value = '';
      const editLabel = document.getElementById('edit_fileLabel');
      if (editLabel) editLabel.textContent = 'Đang dùng ảnh hiện tại';
      document.getElementById('edit_description').value = data.description || '';
      document.getElementById('edit_isActive').checked = Boolean(data.isActive);

      const preview = document.getElementById('edit_previewImg');
      if (data.imageUrl) {
        preview.src = data.imageUrl;
        preview.classList.remove('hidden');
      } else {
        preview.classList.add('hidden');
      }

      const hasLegacyRange = Boolean(data.durationMinutes && data.durationMinutes.min !== data.durationMinutes.max);
      document.getElementById('edit_draftNotice').querySelector('p').textContent = hasLegacyRange
        ? 'Dịch vụ này đang dùng khoảng thời gian cũ. Khi lưu, hệ thống sẽ chuyển về một thời lượng; lịch đã đặt không thay đổi.'
        : 'Thay đổi chỉ áp dụng cho dịch vụ; lịch đã đặt giữ nguyên thông tin.';
      document.getElementById('editModal').showModal();
    } catch (e) {
      console.error('Không thể mở modal chỉnh sửa:', e);
    }
  }

  function closeEditModal() {
    document.getElementById('editModal').close();
  }

  function handleImageFileSelect(input, hiddenInputId, previewImgId, labelId) {
    const file = input.files && input.files[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
      alert('Vui lòng chọn ảnh có dung lượng dưới 5MB.');
      input.value = '';
      return;
    }

    if (labelId) {
      const label = document.getElementById(labelId);
      if (label) label.textContent = 'Đã chọn: ' + file.name;
    }

    const reader = new FileReader();
    reader.onload = function(e) {
      const dataUrl = e.target.result;
      document.getElementById(hiddenInputId).value = dataUrl;
      const preview = document.getElementById(previewImgId);
      if (preview) {
        preview.src = dataUrl;
        preview.classList.remove('hidden');
      }
    };
    reader.readAsDataURL(file);
  }

  function validateAddForm() {
    const dataUrl = document.getElementById('add_imageDataUrl').value;
    const url = document.getElementById('add_imageUrl') ? document.getElementById('add_imageUrl').value : '';
    if (!dataUrl && !url) {
      alert('Vui lòng bấm "Chọn ảnh từ thiết bị" để tải ảnh đại diện cho dịch vụ.');
      return false;
    }
    return true;
  }

  // Close modals on clicking outside or pressing Escape
  window.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeAddModal();
      closeEditModal();
    }
  });

  document.getElementById('addModal').addEventListener('click', function(e) {
    if (e.target === this) closeAddModal();
  });

  document.getElementById('editModal').addEventListener('click', function(e) {
    if (e.target === this) closeEditModal();
  });
</script>

