          <div>
            <img id="add_previewImg" class="h-20 w-20 rounded-xl object-cover hidden border border-[#e7e2da] shadow-xs" alt="Xem trước ảnh" />
          </div>
        </div>
      </div>

      <div>
        <label for="add_description" class="block text-xs font-semibold text-ink mb-1">Mô tả dịch vụ</label>
        <textarea
          id="add_description"
          name="description"
          rows="2"
          placeholder="Mô tả kỹ thuật, tác dụng và quy trình chăm sóc của dịch vụ..."
          class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
