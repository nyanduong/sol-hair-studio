            id="edit_category"
            name="category"
            type="text"
            required
            class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="edit_priceVnd" class="block text-xs font-semibold text-ink mb-1">Giá niêm yết (VNĐ) <span class="text-red-500">*</span></label>
          <input
            id="edit_priceVnd"
            name="priceVnd"
            type="number"
            min="0"
            max="100000000"
            step="1000"
            required
            class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
          />
        </div>

        <div>
          <label for="edit_durationMin" class="block text-xs font-semibold text-ink mb-1">Thời lượng min (phút) <span class="text-red-500">*</span></label>
          <input
            id="edit_durationMin"
            name="durationMin"
            type="number"
            min="1"
            max="480"
            required
            class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
          />
        </div>

        <div>
          <label for="edit_durationMax" class="block text-xs font-semibold text-ink mb-1">Thời lượng max (phút) <span class="text-red-500">*</span></label>
          <input
            id="edit_durationMax"
            name="durationMax"
            type="number"
            min="1"
            max="480"
            required
            class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="edit_bookingDurationMinutes" class="block text-xs font-semibold text-ink mb-1">Thời lượng slot đặt lịch (phút)</label>
          <input
            id="edit_bookingDurationMinutes"
            name="bookingDurationMinutes"
            type="number"
            min="1"
            max="480"
            class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
          />
        </div>

        <div>
          <label for="edit_displayOrder" class="block text-xs font-semibold text-ink mb-1">Thứ tự hiển thị</label>
          <input
            id="edit_displayOrder"
            name="displayOrder"
            type="number"
            min="0"
            class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-ink mb-1.5">Hình ảnh dịch vụ</label>
        <div class="space-y-3 p-3.5 rounded-xl border border-[#e7e2da] bg-[#fcfbf9]/60">
          <div class="flex flex-wrap items-center gap-3">
            <label for="edit_imageFileInput" class="cursor-pointer inline-flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-[#b55338] hover:bg-[#96422b] text-white text-xs font-semibold shadow-xs transition active:scale-[0.98]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Thay ảnh từ thiết bị</span>
