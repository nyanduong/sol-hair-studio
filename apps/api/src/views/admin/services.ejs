            />
            <span id="edit_fileLabel" class="text-xs text-[#7a7269]">Đang dùng ảnh hiện tại</span>
            <input type="hidden" id="edit_imageDataUrl" name="imageDataUrl" />
            <input type="hidden" id="edit_imageUrl" name="imageUrl" />
          </div>

          <div>
            <img id="edit_previewImg" class="h-20 w-20 rounded-xl object-cover hidden border border-[#e7e2da] shadow-xs" alt="Xem trước ảnh" />
          </div>
        </div>
      </div>

      <div>
        <label for="edit_description" class="block text-xs font-semibold text-ink mb-1">Mô tả dịch vụ</label>
        <textarea
          id="edit_description"
          name="description"
          rows="2"
          class="w-full rounded-xl border border-[#e7e2da] px-3.5 py-2 text-sm text-ink focus:border-[#b55338] focus:ring-1 focus:ring-[#b55338]"
        ></textarea>
      </div>

      <div class="flex items-center space-x-2 pt-2">
        <input
          id="edit_isActive"
          name="isActive"
          type="checkbox"
          value="true"
          class="h-4 w-4 rounded border-[#e7e2da] text-[#b55338] focus:ring-[#b55338]"
        />
        <label for="edit_isActive" class="text-xs font-semibold text-ink cursor-pointer">
