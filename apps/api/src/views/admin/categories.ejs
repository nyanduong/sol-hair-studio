<%- include('layout-header', { title, identity, activeTab }) %>
<div class="space-y-6">
  <div><h1 class="text-3xl font-bold">Danh mục dịch vụ</h1><p class="mt-2 text-sm text-muted">Tạo danh mục tại đây, sau đó chọn trong form dịch vụ.</p><a href="/admin/services" class="mt-3 inline-flex min-h-11 items-center font-semibold text-terracotta underline">← Quản lý dịch vụ</a></div>
  <% if (error) { %><p role="alert" class="rounded-xl bg-red-50 p-4 text-red-800"><%= error %></p><% } %>
  <% if (success) { %><p role="status" class="rounded-xl bg-emerald-50 p-4 text-emerald-800">Đã lưu danh mục.</p><% } %>
  <form action="/admin/service-categories" method="POST" class="flex flex-wrap items-end gap-4 rounded-2xl border border-border bg-white p-5"><label class="grow text-sm font-semibold">Tên danh mục mới<input name="name" required maxlength="80" placeholder="Ví dụ: Cắt & tạo kiểu" class="mt-2 block min-h-11 w-full rounded-xl border border-border px-3"></label><button class="min-h-11 rounded-xl bg-terracotta px-5 text-sm font-semibold text-white">Thêm danh mục</button></form>
  <section class="rounded-2xl border border-border bg-white p-5"><h2 class="text-xl font-bold">Danh mục hiện có</h2><p class="mt-2 text-sm text-muted">Đổi tên sẽ cập nhật danh mục trên dịch vụ hiện có. Ngừng dùng chỉ ngăn chọn cho dịch vụ mới; không tự ẩn dịch vụ hoặc thay đổi lịch đã đặt.</p>
    <% if (!categories.length) { %><p class="py-8 text-sm text-muted">Chưa có danh mục. Thêm danh mục đầu tiên ở trên.</p><% } %>
    <ul class="mt-4 divide-y divide-border"><% for (const category of categories) { %><li class="flex flex-wrap items-end gap-4 py-5">
      <form action="/admin/service-categories/<%= category.id %>" method="POST" class="flex grow flex-wrap items-end gap-3"><label class="grow text-sm">Tên danh mục<input aria-label="Tên danh mục <%= category.name %>" name="name" value="<%= category.name %>" required maxlength="80" class="mt-2 block min-h-11 w-full rounded-xl border border-border px-3"></label><button class="min-h-11 rounded-xl border border-border px-4 text-sm font-semibold">Lưu tên</button></form>
      <span class="py-3 text-sm text-muted"><%= category.isActive ? 'Đang dùng' : 'Ngừng dùng' %></span><form action="/admin/service-categories/<%= category.id %>" method="POST"><input type="hidden" name="isActive" value="<%= !category.isActive %>"><button class="min-h-11 rounded-xl border border-border px-4 text-sm font-semibold"><%= category.isActive ? 'Ngừng dùng' : 'Mở lại' %></button></form>
    </li><% } %></ul>
  </section>
  <details class="rounded-2xl border border-border p-5"><summary class="cursor-pointer font-semibold">Chuyển danh mục từ dữ liệu dịch vụ cũ</summary><p class="my-3 text-sm text-muted">Nếu có dịch vụ tạo trước trang quản lý này, nhập các tên danh mục cũ vào danh sách chung. Không tạo dịch vụ hoặc bật lại danh mục đã ngừng dùng.</p><form action="/admin/service-categories/import" method="POST"><button class="min-h-11 rounded-xl border border-border bg-white px-4 text-sm font-semibold">Nhập danh mục từ dịch vụ cũ</button></form></details>
</div>
<%- include('layout-footer') %>