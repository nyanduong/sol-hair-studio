<%- include('layout-header', { title, identity, activeTab }) %>

<div class="space-y-6">
  <div class="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-ink">Tổng quan salon</h1>
      <p class="mt-2 text-sm text-muted">Theo dõi lịch hẹn và hoạt động trong ngày.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <time datetime="<%= todayStr %>" class="rounded-xl border border-border bg-white px-4 py-3 text-sm font-medium"><%= todayStr.split('-').reverse().join(' / ') %></time>
      <a href="/owner/appointments" class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-terracotta px-5 py-3 text-sm font-semibold text-white transition hover:bg-terracotta-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2"/></svg>
        Xem lịch salon
      </a>
    </div>
  </div>

  <nav aria-label="Tổng quan hôm nay" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <% const cards = [
      { title: 'Lịch hẹn hôm nay', value: todayStats.total + ' ca', description: 'Chờ: ' + todayStats.confirmed + ' · Đang làm: ' + todayStats.inProgress + ' · Hoàn tất: ' + todayStats.completed, href: '/admin/appointments?localDate=' + todayStr, action: 'Xem lịch hôm nay' },
      { title: 'Đang phục vụ', value: todayStats.inProgress + ' ca', description: 'Khách đang làm tóc trong lịch hôm nay', href: '/admin/appointments?localDate=' + todayStr + '&status=in_progress', action: 'Xem khách đang phục vụ' },
      { title: 'Đã thu hôm nay', value: formatVnd(todayStats.paidVnd || 0), description: 'Theo ngày nhận tiền, kể cả lịch ngày khác', href: '/admin/revenue?range=custom&from=' + todayStr + '&to=' + todayStr + '&group=day#cash-receipts', action: 'Xem tiền đã thu' },
      { title: 'Hoàn tất chưa thu', value: formatVnd(todayStats.unpaidVnd || 0), description: 'Hôm nay · ' + (todayStats.unpaidCount || 0) + ' lịch cần thu tiền', href: '/admin/appointments?localDate=' + todayStr + '&status=completed&paymentStatus=unpaid', action: 'Xử lý lịch chưa thu' },
    ]; for (const card of cards) { %>
      <a data-dashboard-card href="<%= card.href %>" class="group flex flex-col rounded-2xl border border-border bg-white p-5 shadow-sm transition hover:border-terracotta hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta">
        <h2 class="text-sm font-semibold text-ink"><%= card.title %></h2>
        <p class="mt-5 text-3xl font-bold tracking-tight text-ink"><%= card.value %></p>
        <p class="mt-2 text-xs leading-relaxed text-muted"><%= card.description %></p>
        <span class="mt-auto pt-5 text-xs font-semibold text-terracotta group-hover:underline"><%= card.action %> <span aria-hidden="true">↗</span></span>
      </a>
    <% } %>
  </nav>
  <nav aria-label="Quản lý salon" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <a href="/admin/services" class="min-h-11 py-3 font-semibold text-terracotta hover:underline">Quản lý dịch vụ (<%= activeServicesCount %> đang nhận lịch) ↗</a>
    <a href="/admin/nhan-su" class="min-h-11 py-3 font-semibold text-terracotta hover:underline">Quản lý nhân sự (<%= activeStaffCount %> stylist hoạt động) ↗</a>
    <a href="/admin/revenue?range=today" class="min-h-11 py-3 font-semibold text-terracotta hover:underline">Báo cáo giá trị dịch vụ ↗</a>
  </nav>
  <!-- Today's Live Queue Table -->
  <div class="rounded-2xl bg-white border border-[#e7e2da] shadow-sm overflow-hidden">
    <div class="p-5 border-b border-[#e7e2da] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold text-ink">Lịch hẹn hôm nay</h2>
        <p class="text-xs text-[#7a7269] mt-0.5">Lịch mới đặt hiển thị trước · <%= todayAppointments.length %> lịch hẹn</p>
      </div>
      <a href="/owner/appointments" class="inline-flex min-h-11 items-center text-sm font-semibold text-terracotta hover:underline">Xem lịch salon <span aria-hidden="true" class="ml-2">↗</span></a>
    </div>

    <% if (todayAppointments.length === 0) { %>
      <div class="px-6 py-16 text-center">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-[#f4f0ea] text-[#7a7269] flex items-center justify-center mb-3">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-sm font-bold text-ink">Hôm nay chưa có lịch hẹn nào</h3>
        <p class="text-xs text-[#7a7269] mt-1 max-w-sm mx-auto">
          Khi có khách đặt lịch trên web hoặc ứng dụng di động, các ca hẹn sẽ tự động xuất hiện tại đây.
        </p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[900px] text-left border-collapse">
          <thead>
            <tr class="border-b border-[#e7e2da] bg-[#fcfbf9] text-xs font-semibold text-muted">
              <th scope="col" class="py-3 px-4">Giờ hẹn</th>
              <th scope="col" class="py-3 px-4">Khách hàng</th>
              <th scope="col" class="py-3 px-4">Dịch vụ</th>
              <th scope="col" class="py-3 px-4">Stylist</th>
              <th scope="col" class="py-3 px-4 text-right">Tổng tiền</th>
              <th scope="col" class="py-3 px-4 text-center">Trạng thái</th>
              <th scope="col" class="py-3 px-4 text-center">Thao tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e7e2da] text-sm">
            <% todayAppointments.forEach(function(apt) { %>
              <tr class="hover:bg-[#fcfbf9] transition">
                <!-- Giờ hẹn -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <div class="font-bold text-ink">
                    <%= formatTime(apt.startAt) %> – <%= formatTime(apt.endAt) %>
                  </div>
                  <div class="text-xs text-[#7a7269]"><%= apt.totalDurationMinutes %> phút</div>
                </td>

                <!-- Khách hàng -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <div class="font-semibold text-ink"><%= apt.customerSnapshot?.displayName || 'Khách vãng lai' %></div>
                  <div class="text-xs text-[#7a7269]"><%= apt.customerSnapshot?.phone || '—' %></div>
                </td>

                <!-- Dịch vụ -->
                <td class="py-4 px-4">
                  <div class="max-w-[220px]">
                    <% if (apt.items && apt.items.length > 0) { %>
                      <div class="font-medium text-ink truncate" title="<%= apt.items.map(i => i.name).join(', ') %>">
                        <%= apt.items.map(i => i.name).join(', ') %>
                      </div>
                      <div class="text-xs text-[#7a7269]"><%= apt.items.length %> dịch vụ</div>
                    <% } else { %>
                      <span class="text-[#7a7269]">—</span>
                    <% } %>
                  </div>
                </td>

                <!-- Stylist -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <div class="font-medium text-ink"><%= apt.staffNameSnapshot || 'Chưa chỉ định' %></div>
                </td>

                <!-- Tổng tiền -->
                <td class="py-4 px-4 whitespace-nowrap text-right font-bold text-ink">
                  <%= formatVnd(apt.totalPriceVnd) %>
                </td>

                <!-- Trạng thái badge -->
                <td class="py-4 px-4 whitespace-nowrap text-center">
                  <% if (apt.status === 'confirmed') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-100">
                      Chờ phục vụ
                    </span>
                  <% } else if (apt.status === 'in_progress') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                      Đang làm tóc
                    </span>
                  <% } else if (apt.status === 'completed') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      Hoàn thành
                    </span>
                  <% } else if (apt.status === 'cancelled') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                      Đã hủy
                    </span>
                  <% } else if (apt.status === 'no_show') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                      Vắng mặt
                    </span>
                  <% } %>
                </td>

                <!-- Thao tác -->
                <td class="py-4 px-4 whitespace-nowrap text-center">
                  <a
                    href="/owner/appointments/<%= apt._id %>"
                    class="inline-flex min-h-11 items-center text-sm font-semibold text-[#b55338] hover:text-[#96422b] hover:underline"
                  >
                    Chi tiết →
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Bottom Two Columns: Top Services & Status Breakdown -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Top 5 Dịch vụ được ưa chuộng -->
    <div class="rounded-2xl bg-white border border-[#e7e2da] p-5 shadow-sm">
      <div class="flex items-center justify-between border-b border-[#e7e2da] pb-4 mb-4">
        <div>
          <h2 class="text-sm font-bold text-ink">Dịch vụ đã hoàn tất</h2>
          <p class="text-xs text-[#7a7269] mt-0.5">Xếp hạng theo lượt đã phục vụ · toàn thời gian</p>
        </div>
        <a href="/admin/services" class="text-xs font-semibold text-[#b55338] hover:underline">
          Xem tất cả
        </a>
      </div>

      <% if (!topServices || topServices.length === 0) { %>
        <p class="text-xs text-[#7a7269] py-8 text-center">Chưa có đủ dữ liệu lịch hẹn để xếp hạng dịch vụ.</p>
      <% } else { %>
        <div class="space-y-3">
          <% topServices.forEach(function(item, idx) { %>
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#fcfbf9] border border-[#e7e2da]/70">
              <div class="flex items-center space-x-3">
                <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold <%= idx === 0 ? 'bg-amber-100 text-amber-800' : (idx === 1 ? 'bg-slate-200 text-slate-700' : (idx === 2 ? 'bg-orange-100 text-orange-800' : 'bg-gray-100 text-[#7a7269]')) %>">
                  <%= idx + 1 %>
                </span>
                <div>
                  <div class="font-semibold text-xs text-ink"><%= item._id %></div>
                  <div class="text-xs text-[#7a7269]"><%= item.count %> lượt hoàn tất</div>
                </div>
              </div>
              <div class="text-right">
                <div class="text-xs font-bold text-ink"><%= formatVnd(item.totalRevenue) %></div>
                <div class="text-xs text-emerald-600 font-medium">Giá trị hoàn tất</div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Phân bổ trạng thái lịch hẹn & Lối tắt -->
    <div class="rounded-2xl bg-white border border-[#e7e2da] p-5 shadow-sm flex flex-col justify-between">
      <div>
        <div class="border-b border-[#e7e2da] pb-4 mb-4">
          <h2 class="text-sm font-bold text-ink">Phân bổ trạng thái lịch hẹn</h2>
          <p class="text-xs text-[#7a7269] mt-0.5">Toàn thời gian · Tổng số: <strong class="text-ink"><%= totalAppointments %></strong> lượt đặt trên toàn hệ thống</p>
        </div>

        <!-- Progress Bars Breakdown -->
        <div class="space-y-3.5">
          <!-- Hoàn thành -->
          <div>
            <div class="flex justify-between text-xs font-medium mb-1">
              <span class="text-emerald-700 flex items-center">
                <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span>
                Hoàn thành (<%= statusMap.completed %> ca)
              </span>
              <span class="text-[#7a7269] font-semibold">
                <%= totalAppointments > 0 ? Math.round((statusMap.completed / totalAppointments) * 100) : 0 %>%
              </span>
            </div>
            <div class="w-full bg-[#f4f0ea] h-2.5 rounded-full overflow-hidden">
              <div class="bg-emerald-500 h-2.5 rounded-full" style="width: <%= totalAppointments > 0 ? (statusMap.completed / totalAppointments) * 100 : 0 %>%"></div>
            </div>
          </div>

          <!-- Đang chờ / Đang làm -->
          <div>
            <div class="flex justify-between text-xs font-medium mb-1">
              <span class="text-blue-700 flex items-center">
                <span class="w-2 h-2 rounded-full bg-blue-500 mr-1.5"></span>
                Chờ & Đang làm (<%= statusMap.confirmed + statusMap.in_progress %> ca)
              </span>
              <span class="text-[#7a7269] font-semibold">
                <%= totalAppointments > 0 ? Math.round(((statusMap.confirmed + statusMap.in_progress) / totalAppointments) * 100) : 0 %>%
              </span>
            </div>
            <div class="w-full bg-[#f4f0ea] h-2.5 rounded-full overflow-hidden">
              <div class="bg-blue-500 h-2.5 rounded-full" style="width: <%= totalAppointments > 0 ? ((statusMap.confirmed + statusMap.in_progress) / totalAppointments) * 100 : 0 %>%"></div>
            </div>
          </div>

          <!-- Đã hủy / Vắng mặt -->
          <div>
            <div class="flex justify-between text-xs font-medium mb-1">
              <span class="text-red-700 flex items-center">
                <span class="w-2 h-2 rounded-full bg-red-400 mr-1.5"></span>
                Đã hủy & Vắng mặt (<%= statusMap.cancelled + statusMap.no_show %> ca)
              </span>
              <span class="text-[#7a7269] font-semibold">
                <%= totalAppointments > 0 ? Math.round(((statusMap.cancelled + statusMap.no_show) / totalAppointments) * 100) : 0 %>%
              </span>
            </div>
            <div class="w-full bg-[#f4f0ea] h-2.5 rounded-full overflow-hidden">
              <div class="bg-red-400 h-2.5 rounded-full" style="width: <%= totalAppointments > 0 ? ((statusMap.cancelled + statusMap.no_show) / totalAppointments) * 100 : 0 %>%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Action Cards -->
      <div class="mt-6 pt-4 border-t border-[#e7e2da] grid grid-cols-2 gap-3">
        <a
          href="/admin/services"
          class="p-3 rounded-xl border border-[#e7e2da] bg-[#fcfbf9] hover:bg-[#f4f0ea] transition flex flex-col justify-center items-center text-center group"
        >
          <span class="text-xs font-semibold text-ink group-hover:text-[#b55338]">Cấu hình Dịch vụ</span>
          <span class="text-xs text-[#7a7269] mt-0.5">Giá, ảnh, thời lượng</span>
        </a>
        <a
          href="/owner/appointments"
          class="p-3 rounded-xl border border-[#e7e2da] bg-[#fcfbf9] hover:bg-[#f4f0ea] transition flex flex-col justify-center items-center text-center group"
        >
          <span class="text-xs font-semibold text-ink group-hover:text-[#b55338]">Lịch toàn Salon</span>
          <span class="text-xs text-[#7a7269] mt-0.5">Xử lý ca hẹn & đổi giờ</span>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('layout-footer') %>

