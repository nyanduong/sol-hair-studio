<!DOCTYPE html>
<html lang="vi" class="h-full bg-[#fcfbf9] text-[#2c2825]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Sol Hair Studio Admin' %></title>
  <% if (locals.staffStylesheet) { %>
    <link rel="stylesheet" href="/admin/assets/staff-admin.css">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            terracotta: {
              DEFAULT: '#b55338',
              hover: '#96422b',
              light: '#fdf2ef',
            },
            canvas: '#fcfbf9',
            ink: '#2c2825',
            muted: '#7a7269',
            border: '#e7e2da',
            'soft-surface': '#f4f0ea',
          }
        }
      }
    }
  </script>
</head>
<body class="flex flex-col min-h-full font-sans antialiased text-[#2c2825] bg-[#fcfbf9]">
  <header class="sticky top-0 z-30 border-b border-[#e7e2da] bg-white/95 backdrop-blur shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <a href="/admin/dashboard" class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-full bg-[#b55338] text-white flex items-center justify-center font-bold text-sm tracking-wider">
            SOL
          </div>
          <div>
            <span class="font-bold text-base tracking-wide text-ink block leading-none">SOL HAIR STUDIO</span>
            <span class="text-[10px] font-semibold text-[#b55338] uppercase tracking-widest block mt-0.5">Trang Quản Trị Salon</span>
          </div>
        </a>
        <nav class="hidden md:flex items-center space-x-1 pl-6">
          <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg text-sm font-semibold transition <%= locals.activeTab === 'dashboard' ? 'bg-[#b55338]/10 text-[#b55338]' : 'text-[#7a7269] hover:text-ink hover:bg-[#f4f0ea]' %>">
            Tổng quan
          </a>
          <a href="/admin/services" class="px-3 py-1.5 rounded-lg text-sm font-semibold transition <%= locals.activeTab === 'services' ? 'bg-[#b55338]/10 text-[#b55338]' : 'text-[#7a7269] hover:text-ink hover:bg-[#f4f0ea]' %>">
            Quản lý Dịch vụ
          </a>
          <a href="/admin/nhan-su"<% if (locals.activeTab === 'staff') { %> aria-current="page"<% } %> class="px-3 py-1.5 rounded-lg text-sm font-semibold transition <%= locals.activeTab === 'staff' ? 'bg-[#b55338]/10 text-[#b55338]' : 'text-[#7a7269] hover:text-ink hover:bg-[#f4f0ea]' %>">
            Nhân sự
          </a>
          <a href="/owner/appointments" class="px-3 py-1.5 rounded-lg text-sm font-medium text-[#7a7269] hover:text-ink hover:bg-[#f4f0ea] transition">
            Lịch Salon
          </a>

        </nav>
      </div>

      <div class="flex items-center space-x-4">
        <% if (locals.identity) { %>
          <div class="text-right hidden sm:block">
            <div class="text-xs font-semibold text-ink"><%= identity.displayName || identity.email %></div>
            <div class="text-[10px] font-medium text-emerald-600 uppercase tracking-wider">Chủ tiệm</div>
          </div>
          <form action="/admin/logout" method="POST" class="inline">
            <button type="submit" class="text-xs font-medium text-[#7a7269] hover:text-[#b55338] border border-[#e7e2da] hover:border-[#b55338]/40 px-3 py-1.5 rounded-lg transition">
              Đăng xuất
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </header>
  <main class="flex-1 py-8 px-4 sm:px-6 lg:px-8 max-w-7xl w-full mx-auto">
