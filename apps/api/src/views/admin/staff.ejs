<%- include('layout-header', { title, identity, activeTab, staffStylesheet }) %>

  <section class="staff-page" data-today="<%= today %>" data-api-token="<%= apiToken %>">
    <div class="staff-container">
      <section class="intro">
        <div>
          <h1>Nhân sự &amp; ca làm</h1>
          <p>Quản lý đội ngũ, dịch vụ và lịch làm việc theo tuần.</p>
        </div><button class="primary" type="button" data-action="new-profile" hidden>+ Thêm nhân viên</button>
      </section>
      <p id="feedback" role="status" aria-live="polite"></p>
      <section id="access" class="card"></section>
      <div id="admin-workspace" class="workspace" hidden>
        <aside class="team card">
          <div class="section-heading">
            <h2>Đội ngũ</h2><span id="people-count"></span>
          </div>
          <div id="people-list"></div>
        </aside>
        <div id="details"></div>
      </div>
      <section id="profile-form" class="card form-card" hidden></section>
      <section id="shift-form" class="card form-card" hidden></section>
    </div>
  </section>

  <script src="/admin/assets/staff-admin.js" defer></script>
  <%- include('layout-footer') %>