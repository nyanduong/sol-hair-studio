<section class="border-t border-border bg-canvas px-5 py-4 sm:px-6" aria-labelledby="payment-heading">
<h2 id="payment-heading" class="text-sm font-bold">Thanh toán tại salon</h2>
<p id="payment-summary" role="status" class="my-3 text-sm text-muted">Đang tải trạng thái thanh toán…</p>
<button id="payment-refresh" class="min-h-10 rounded-xl px-3 py-2 text-xs font-semibold text-muted hover:bg-soft-surface">↻ Tải lại trạng thái</button>
<button id="payment-open" hidden class="min-h-11 rounded-xl bg-terracotta px-5 py-2 text-sm font-semibold text-white">Thu tiền qua QR</button>
</section>
<dialog id="payment-dialog" aria-labelledby="payment-dialog-title" class="w-[calc(100%-2rem)] max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl bg-white p-6 text-ink shadow-xl backdrop:bg-black/40">
<div class="flex items-center justify-between gap-3"><h2 id="payment-dialog-title" class="text-xl font-bold">Thu tiền qua QR</h2><button id="payment-close" aria-label="Đóng thu tiền" class="rounded-lg border border-border px-3 py-2">✕</button></div>
<p id="payment-amount" class="my-4 text-2xl font-bold"></p><img src="/admin-assets/qr/qr-code.jpg" alt="QR chuyển khoản tài khoản chủ tiệm" class="mx-auto max-h-64 w-full object-contain">
<p class="mt-4 text-sm">Nội dung chuyển khoản: <strong id="payment-reference" class="break-all"></strong></p>
<p class="mt-3 text-sm text-muted">QR của chủ tiệm. Khách nhập đúng số tiền và nội dung trên. Quét QR không tự xác nhận đã thanh toán.</p>
<form id="payment-confirm" class="mt-5"><label class="flex items-start gap-3 text-sm"><input required type="checkbox" id="payment-attest" class="mt-1">Tôi đã kiểm tra tiền vào tài khoản chủ tiệm và xác nhận đã nhận đủ số tiền trên.</label><p id="payment-error" role="alert" class="my-3 text-sm text-terracotta"></p><button id="payment-submit" class="min-h-11 w-full rounded-xl bg-terracotta px-5 py-3 font-semibold text-white">Xác nhận đã nhận tiền</button></form>
</dialog>
<script id="payment-config" type="application/json"><%- JSON.stringify({ appointmentId, token }).replace(/</g, '\u003c') %></script>
<script src="/admin/assets/payment-admin.js" defer></script>
