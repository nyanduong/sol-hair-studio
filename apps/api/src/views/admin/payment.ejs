<section id="payment" data-payment-busy="false" class="min-w-0 border-t border-border bg-canvas px-5 py-5 md:border-l md:border-t-0 sm:px-6" aria-labelledby="payment-heading">
  <div class="md:sticky md:top-4">
    <h2 id="payment-heading" class="text-xl font-bold">Thu tiền tại salon</h2>
    <p id="payment-summary" role="status" class="my-3 text-sm text-muted">Đang tải trạng thái thanh toán…</p>
    <p id="payment-amount" class="my-4 text-3xl font-bold"></p>
    <div id="payment-collection" hidden>
      <img src="/admin-assets/qr/qr-code.jpg" alt="QR chuyển khoản tài khoản chủ tiệm" class="mx-auto max-h-48 w-full object-contain">
      <p class="mt-2 text-center text-xs text-muted">Tài khoản chủ tiệm</p>
      <p class="mt-5 text-sm text-muted">Nội dung chuyển khoản</p>
      <p id="payment-reference" class="mt-2 break-all rounded-xl border border-border bg-white px-3 py-3 font-mono text-sm font-semibold"></p>
      <p class="mt-3 text-xs leading-5 text-muted">Khách nhập đúng số tiền và nội dung trên. Kiểm tra tiền vào tài khoản trước khi xác nhận.</p>
      <form id="payment-confirm" class="mt-5">
        <label class="flex items-start gap-3 text-sm leading-6"><input required type="checkbox" id="payment-attest" class="mt-1.5 size-4 shrink-0">Tôi đã kiểm tra và nhận đủ tiền vào tài khoản chủ tiệm.</label>
        <button id="payment-submit" disabled class="mt-4 min-h-11 w-full rounded-xl bg-terracotta px-4 py-3 text-sm font-semibold text-white hover:bg-terracotta-hover disabled:cursor-not-allowed disabled:opacity-40">Xác nhận đã nhận tiền</button>
        <p class="mt-2 text-center text-xs text-muted">Chưa xác nhận → vẫn chờ thu tiền</p>
      </form>
    </div>
    <p id="payment-error" role="alert" class="my-3 text-sm text-terracotta"></p>
    <button id="payment-refresh" class="min-h-10 rounded-xl px-3 py-2 text-xs font-semibold text-muted hover:bg-soft-surface disabled:opacity-40">↻ Tải lại trạng thái</button>
  </div>
</section>
<script id="payment-config" type="application/json"><%- JSON.stringify({ appointmentId, token }).replace(/</g, '\u003c') %></script>
<script src="/admin/assets/payment-admin.js" defer></script>
