<!DOCTYPE html>
<html lang="vi" class="h-full bg-[#fcfbf9] text-[#2c2825]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Đăng nhập Quản trị viên — Sol Hair Studio' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            terracotta: {
              DEFAULT: '#b55338',
              hover: '#96422b',
              light: '#fdf2ef',
            },
            canvas: '#fcfbf9',
            ink: '#2c2825',
            muted: '#7a7269',
            border: '#e7e2da',
            'soft-surface': '#f4f0ea',
          }
        }
      }
    }
  </script>
</head>
<body class="flex flex-col min-h-full font-sans antialiased text-[#2c2825] bg-[#fcfbf9] justify-center items-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md space-y-8 bg-white p-8 rounded-2xl shadow-xl border border-[#e7e2da]">
    <div class="text-center">
      <div class="inline-flex w-14 h-14 rounded-full bg-[#b55338] text-white items-center justify-center font-bold text-xl tracking-wider mx-auto shadow-md">
        SOL
      </div>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-ink">Quản trị Chủ tiệm</h2>
      <p class="mt-1 text-sm text-[#7a7269]">Đăng nhập vào hệ thống quản lý Sol Hair Studio</p>
    </div>

    <% if (errorMessage) { %>
      <div class="rounded-xl bg-red-50 p-4 border border-red-200">
        <div class="flex">
          <svg class="h-5 w-5 text-red-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
          <div class="ml-3">
            <p class="text-sm font-medium text-red-800"><%= errorMessage %></p>
          </div>
        </div>
      </div>
    <% } %>

    <form class="mt-8 space-y-5" action="/admin/login" method="POST">
      <div>
        <label for="email" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Email Quản trị viên
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          value="<%= email || '' %>"
          placeholder="owner@solhair.vn"
          class="block w-full rounded-xl border border-[#e7e2da] px-3.5 py-2.5 text-sm text-ink placeholder-[#7a7269]/60 focus:border-[#b55338] focus:outline-none focus:ring-2 focus:ring-[#b55338]/20 transition"
        />
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Mật khẩu
        </label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          placeholder="••••••••"
          class="block w-full rounded-xl border border-[#e7e2da] px-3.5 py-2.5 text-sm text-ink placeholder-[#7a7269]/60 focus:border-[#b55338] focus:outline-none focus:ring-2 focus:ring-[#b55338]/20 transition"
        />
      </div>

      <div>
        <button
          type="submit"
          class="flex w-full justify-center rounded-xl bg-[#b55338] py-3 px-4 text-sm font-semibold text-white shadow-sm hover:bg-[#96422b] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b55338] transition active:scale-[0.99]"
        >
          Đăng nhập Quản trị
        </button>
      </div>
    </form>

    <div class="pt-4 border-t border-[#e7e2da] text-center">
      <a href="http://localhost:5173" class="text-xs text-[#7a7269] hover:text-[#b55338] transition">
        &larr; Quay lại trang chủ Sol Hair Studio
      </a>
    </div>
  </div>
</body>
</html>

